<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk to a development server over plain HTTP (emulator host, LAN).
     Release builds only allow HTTPS (see src/main/res/xml/network_security_config.xml). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Intentional and debug only: the development server is chosen by the user at runtime. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
